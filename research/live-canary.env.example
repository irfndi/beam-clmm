# Tiny live canary — copy keys into a local override; do NOT commit secrets.
# Arm only AFTER paper autoresearch win goal passes once.
#
# Usage (example):
#   set -a; source research/live-canary.env.example; set +a
#   # then override PAPER_TRADING=false only when you intend to go live
#
PAPER_TRADING=true
AUTONOMOUS_TOKEN_MODE=canary
MAX_OPEN_POSITIONS=1
MAX_POSITIONS_PER_POOL=1
MAX_ENTRY_SIZE_USD=15
MAX_PER_POOL_ALLOCATION_PCT=0.3
CONFIDENCE_THRESHOLD=0.65
# Kill rule (manual): if realized day loss >= $10, set PAPER_TRADING=true and stop.
