{
  "name": "@beam-clmm/infra",
  "version": "1.0.0",
  "private": true,
  "description": "Alchemy IaC composition root for the Beam Cloudflare stack (Effect 4 runtime)",
  "type": "module",
  "scripts": {
    "dev": "alchemy dev",
    "deploy": "alchemy deploy --stage prod --adopt --yes",
    "plan": "alchemy deploy --stage prod --adopt --dry-run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/platform-node": "4.0.0-rc.112",
    "alchemy": "2.0.0-beta.76",
    "effect": "4.0.0-rc.112"
  },

  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
