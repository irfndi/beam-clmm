{
  "name": "@beam-clmm/cloudflare",
  "version": "1.0.0",
  "description": "Cloudflare Workers for Beam CLMM platform",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "workspaces": [
    "infra"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd infra dev",
    "build:workers": "esbuild workers/api/index.ts --bundle --format=esm --target=es2022 --conditions=workerd,worker,browser --minify --outfile=dist/api/index.mjs && esbuild workers/telegram-bot/index.ts --bundle --format=esm --target=es2022 --conditions=workerd,worker,browser --minify --outfile=dist/telegram-bot/index.mjs",
    "deploy": "bun run build:workers && bun run --cwd infra deploy",
    "plan": "bun run build:workers && bun run --cwd infra plan",
    "typecheck": "tsc --noEmit && bun run --cwd infra typecheck"
  },
  "dependencies": {
    "effect": "4.0.0-rc.112",
    "hono": "^4.13.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260904.1",
    "@vitest/runner": "^4.1.11",
    "@vitest/snapshot": "^4.1.11",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "4.129.0"
  }
}
