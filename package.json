{
  "name": "beam-clmm",
  "version": "0.1.13",
  "description": "Autonomous concentrated-liquidity agent for Uniswap v3 & v4 on Robinhood Chain",
  "keywords": [
    "ai-agent",
    "autonomous",
    "claude",
    "defi",
    "effect-ts",
    "liquidity",
    "rebalancing",
    "robinhood-chain",
    "uniswap-v3",
    "uniswap-v4",
    "viem"
  ],
  "license": "MIT",
  "private": true,
  "files": [
    "dist",
    "engine",
    "cli",
    "scripts",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "beam": "./scripts/beam.sh"
  },
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "start": "bun $(bun scripts/cli-entry.mjs) dev",
    "dev": "bun run --watch $(bun scripts/cli-entry.mjs) dev",
    "build": "bun tsdown",
    "setup": "bun $(bun scripts/cli-entry.mjs) setup",
    "setup:env": "bun run scripts/postinstall.js",
    "postinstall": "bun run scripts/postinstall.js",
    "backtest": "bun $(bun scripts/cli-entry.mjs) backtest",
    "autoresearch": "bun ops/autoresearch.ts",
    "pretest": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "typecheck:fast": "tsrs --noEmit --fast",
    "lint:tsrs": "bash -c \"bunx --bun effect-tsgo --tsrs-lint oxlint --type-aware --deny-warnings $(bun scripts/tool-dirs.mjs)\"",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "lint": "bash scripts/lint.sh",
    "format": "oxfmt --write $(bun scripts/tool-dirs.mjs)",
    "format:check": "oxfmt --check $(bun scripts/tool-dirs.mjs)",
    "coverage": "bun --bun vitest run --coverage",
    "prepare": "effect-tsgo patch --oxlint || echo \"warning: effect-tsgo patch failed (unsupported platform or version mismatch) — type-aware effect lint disabled\""
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@huggingface/transformers": "^4.3.2",
    "@uniswap/sdk-core": "^7.21.0",
    "@uniswap/v3-sdk": "^3.31.10",
    "@uniswap/v4-sdk": "^2.4.6",
    "commander": "^15.1.0",
    "effect": "4.1.2",
    "semver": "^7.8.6",
    "sqlite-vec": "^0.1.9",
    "viem": "^2.57.16"
  },
  "devDependencies": {
    "@effect/tsgo": "0.67.5",
    "@oxlint/plugins": "1.92.0",
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-istanbul": "^5.1.0",
    "bun-types": "1.4.4",
    "fast-check": "^4.10.2",
    "jsbi": "^3.2.5",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "tsdown": "^0.23.7",
    "tsrs": "0.23.0-ts7.1.0-beta",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
