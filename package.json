{
  "name": "beam-clmm",
  "version": "0.1.11",
  "description": "Autonomous concentrated-liquidity agent for Uniswap v3 & v4 on Robinhood Chain",
  "keywords": [
    "ai-agent",
    "autonomous",
    "claude",
    "defi",
    "effect-ts",
    "liquidity",
    "rebalancing",
    "robinhood-chain",
    "uniswap-v3",
    "uniswap-v4",
    "viem"
  ],
  "license": "MIT",
  "private": true,
  "files": [
    "dist",
    "engine",
    "cli",
    "scripts",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "beam": "./scripts/beam.sh"
  },
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "start": "bun $(bun scripts/cli-entry.mjs) dev",
    "dev": "bun run --watch $(bun scripts/cli-entry.mjs) dev",
    "build": "bun tsdown",
    "setup": "bun $(bun scripts/cli-entry.mjs) setup",
    "setup:env": "bun run scripts/postinstall.js",
    "postinstall": "bun run scripts/postinstall.js",
    "backtest": "bun $(bun scripts/cli-entry.mjs) backtest",
    "pretest": "tsc --noEmit",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "lint": "bash scripts/lint.sh",
    "format": "oxfmt --write $(bun scripts/tool-dirs.mjs)",
    "format:check": "oxfmt --check $(bun scripts/tool-dirs.mjs)",
    "coverage": "bun --bun vitest run --coverage",
    "prepare": "effect-tsgo patch --oxlint || echo \"warning: effect-tsgo patch failed (unsupported platform or version mismatch) — type-aware effect lint disabled\""
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@uniswap/sdk-core": "^7.19.2",
    "@uniswap/v3-sdk": "^3.31.3",
    "@uniswap/v4-sdk": "^2.3.3",
    "@xenova/transformers": "^2.17.2",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "effect": "4.0.0-rc.112",
    "semver": "^7.8.5",
    "sqlite-vec": "^0.1.9",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@effect/tsgo": "0.41.0",
    "@types/node": "^26.4.1",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-istanbul": "^5.0.0",
    "bun-types": "1.4.1",
    "fast-check": "^4.9.0",
    "jsbi": "^3.2.5",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
